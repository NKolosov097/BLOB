APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://blob:blob@postgres:5432/blob?sslmode=disable
API_INTERNAL_BASE=http://api:8080/api/v1
NUXT_PUBLIC_API_BASE=/api/v1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
# Trusted browser origin for session cookies/CSRF/CORS. HTTPS only, no
# userinfo/path/query/fragment, no explicit default port, lowercase host.
AUTH_PUBLIC_ORIGIN=https://localhost:8443
# Leave blank; never commit a real signing key. Generate a fresh 32-byte
# standard-base64 key per environment (see README local-start setup) and set
# it in your local, untracked .env before `docker compose up`.
AUTH_BROWSER_KEY=
